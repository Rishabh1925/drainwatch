# DrainWatch environment configuration
# Copy this file to .env and fill in your values.

# --- Supabase (operational data store) ---
# Required: Supabase project URL and service-role key.
# Get these from your Supabase project dashboard → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# --- AWS (optional — omit for local development) ---
# When both DRAINWATCH_BUCKET and DRAINWATCH_TABLE are set, AWS storage is used.
# When unset, images and readings are stored locally under data/local_store/.
# DRAINWATCH_BUCKET=drainwatch-media-prod
# DRAINWATCH_TABLE=drainwatch-readings
# DRAINWATCH_MEDIA_BASE=https://drainwatch-media-prod.s3.ap-southeast-2.amazonaws.com
# AWS_REGION=ap-southeast-2

# --- Model configuration (optional) ---
# Path to the trained SegFormer checkpoint directory.
# Defaults to checkpoints/best/ if not set.
# DRAINWATCH_CHECKPOINT=checkpoints/best

# PyTorch device string. Auto-detected if not set.
# DRAINWATCH_DEVICE=cpu

# --- Server (optional) ---
# PORT=8000

# --- Security (production) ---
# Set to 1 in production where TLS is terminated by a load balancer.
# DRAINWATCH_COOKIE_SECURE=1
