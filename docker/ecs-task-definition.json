{
  "family": "drainwatch",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/drainwatchTaskRole",
  "containerDefinitions": [
    {
      "name": "drainwatch",
      "image": "ACCOUNT_ID.dkr.ecr.ap-southeast-2.amazonaws.com/drainwatch:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-2"
        },
        {
          "name": "DRAINWATCH_BUCKET",
          "value": "drainwatch-media-prod"
        },
        {
          "name": "DRAINWATCH_TABLE",
          "value": "drainwatch-readings"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "DRAINWATCH_COOKIE_SECURE",
          "value": "1"
        }
      ],
      "secrets": [
        {
          "name": "SUPABASE_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT_ID:secret:drainwatch/supabase-key"
        },
        {
          "name": "SUPABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT_ID:secret:drainwatch/supabase-url"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/drainwatch",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true,
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health').read()\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}